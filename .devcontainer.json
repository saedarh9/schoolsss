// Google i webblasaren - hela konfigurationen i en enda fil.
// Filen maste ligga i repots rot och heta exakt ".devcontainer.json".
{
  "name": "Google i webblasaren",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",

  "hostRequirements": { "cpus": 2, "memory": "4gb", "storage": "32gb" },

  // Port 6080 ar skrivbordet.
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "Skrivbordet med Google",
      "onAutoForward": "notify"
    }
  },

  "waitFor": "postCreateCommand",

  // Kors EN gang: installerar skrivbord (Xvfb, fluxbox, x11vnc, noVNC)
  // och Google Chrome.
  "postCreateCommand": "echo  | base64 -d | bash",

  // Kors VARJE gang maskinen startar: drar igang skrivbordet, Chrome och
  // urklippsbryggan som gor vanlig Ctrl+C / Ctrl+V mojlig.
  "postStartCommand": "echo  | base64 -d | bash",

  // Kors VARJE gang du ansluter: vantar tills skrivbordet svarar och
  // oppnar det i en ny flik. Det ar den har som gor att det fungerar
  // aven nar man kommer tillbaka till en maskin som redan finns.
  "postAttachCommand": "echo  | base64 -d | bash"
}
