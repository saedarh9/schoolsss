// Google i webblasaren - hela konfigurationen i en enda fil.
// Filen maste ligga i repots rot och heta exakt ".devcontainer.json".
{
  "name": "Google i webblasaren",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",

  "hostRequirements": { "cpus": 2, "memory": "4gb", "storage": "32gb" },

  // Port 6080 ar skrivbordet. Den oppnas automatiskt i en ny flik.
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "Klicka har for att oppna Google",
      "onAutoForward": "openBrowser"
    }
  },

  "waitFor": "postCreateCommand",

  // Kors EN gang: installerar skrivbord (Xvfb, fluxbox, x11vnc, noVNC)
  // och Google Chrome.
  "postCreateCommand": "echo  | base64 -d | bash",

  // Kors VARJE gang maskinen startar: drar igang skrivbordet och Chrome.
  "postStartCommand": "echo  | base64 -d | bash"
}
